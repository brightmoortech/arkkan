# Example libpq environment settings (not automatically loaded).
# Set PGDATABASE and PGUSER for initialization or CLI use in later stages.
# export PGDATABASE=your_database
# export PGUSER=your_role
# Optional settings; libpq supplies defaults when omitted.
# export PGHOST=localhost
# export PGPORT=5432
# export PGPASSFILE=/path/to/password-file
# Set credentials separately using the PostgreSQL password-file mechanism.
