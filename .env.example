# Copy to .env locally and supply environment-specific values.
# Use literal KEY=VALUE lines; no shell commands, quotes or interpolation.
# Paths may be absolute or relative to the checkout; ~/ is supported by the
# environment utility. Supply absolute paths for direct libpq use.
# Use the same PGDATABASE and PGUSER for initial PostgreSQL provisioning.
ARKKAN_ENVIRONMENT=
COMPOSE_PROJECT_NAME=
POSTGRES_CONTAINER_NAME=
PGHOST=localhost
PGPORT=
PGDATABASE=
PGUSER=
# Optional: omit or leave empty to use ~/.pgpass.
PGPASSFILE=
POSTGRES_DATA_DIR=
POSTGRES_PASSWORD_FILE=
# Never put password values in this file.
